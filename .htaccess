# Apache：禁止直接访问 lib / database
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib/ - [F,L]
  RewriteRule ^database/ - [F,L]

  # OpenAI 兼容网关（无 .php 后缀）
  RewriteRule ^api/v1/chat/completions$ api/v1/chat/completions.php [L,QSA]
  RewriteRule ^api/v1/models$ api/v1/models.php [L,QSA]
</IfModule>

# PHP 7.4+
<IfModule mod_php.c>
  php_flag display_errors Off
</IfModule>
